{"nodes": [{"id": "readme_zch", "label": "ZCH", "file_type": "concept", "source_file": "README.md", "source_location": "L1-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single Rust binary TUI that receives competitive-programming problems, times samples, and submits to Codeforces from one local dashboard."}, {"id": "readme_zed", "label": "Zed Editor", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_competitive_companion", "label": "Competitive Companion", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_codeforces", "label": "Codeforces", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_safari_automation", "label": "Safari Apple Events Automation", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_safari_only", "label": "Why Safari Only", "file_type": "rationale", "source_file": "README.md", "source_location": "L37-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submission automation must run JavaScript in the background without stealing focus. Only Safari supports this natively via AppleScript; other browsers would foreground the window mid-solve."}, {"id": "readme_tui_dashboard", "label": "Live TUI Dashboard", "file_type": "concept", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directory bar, message console, verdict cards, and a footer that always shows the current mode plus its keys so status never resizes the rest of the UI."}, {"id": "readme_verdict_chips", "label": "Instant Verdict Chips", "file_type": "concept", "source_file": "README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each case gets AC/WA/TLE/RE/CE chips and auto-collapses on AC; WA marks differing characters in red so the mismatch is visible without leaving the TUI."}, {"id": "readme_problem_ingest", "label": "Problem Auto-Parse", "file_type": "concept", "source_file": "README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payloads on 127.0.0.1:10043 create a file from ~/.zch/boilerplate.cpp with a // URL: header, store tests in ~/.zch/.tc/, and open the file in Zed. Same sanitized filenames get a short URL suffix so tests and binaries do not overwrite."}, {"id": "readme_compile_cache", "label": "Content-Hash Compile Cache", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compile once and cache the binary by source hash plus flags so unchanged code replays every case instantly, with 1ms polling, per-case timing, and hard TLE kills."}, {"id": "readme_cf_submit", "label": "One-Key Codeforces Submission", "file_type": "concept", "source_file": "README.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A confirmation modal shows every detail, then async verdicts stream into the Submissions bar. Safari tabs are tracked by URL with INTERRUPTED, TIMED OUT, and a hard 5-minute timeout."}, {"id": "readme_zch_send", "label": "zch send Command API", "file_type": "concept", "source_file": "README.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zed tasks drive the running TUI over HTTP (send r, send s) with the active ZED_FILE and report real success or refusal reasons. ZCH_PORT overrides the default port 10043."}, {"id": "readme_dir_console", "label": "Live Directory Console", "file_type": "concept", "source_file": "README.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_languages", "label": "Multi-Language Support", "file_type": "concept", "source_file": "README.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C++, Python 3, and Java. No hidden flags: -O2, -std=c++20, and -include-pch are entered as individually validated tags so the Codeforces language id follows the user's -std= tag."}, {"id": "readme_flag_tags", "label": "Validated Compile-Flag Tags", "file_type": "concept", "source_file": "README.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags must start with -, duplicates and unknown -std= versions are rejected, and lists are stored per language in ~/.zch/config.json. No -std, -O2, or warning flags are added implicitly. Codeforces ids: C++17 \u2192 54, C++20 \u2192 89, C++23 \u2192 91. Deleting either half of a -include-pch pair removes both."}, {"id": "readme_zed_tasks", "label": "Zed Tasks", "file_type": "concept", "source_file": "README.md", "source_location": "L58-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_zed_keymap", "label": "Zed Keymap Macros", "file_type": "concept", "source_file": "README.md", "source_location": "L91-L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cmd-r spawns the dashboard in the center pane then splits right with Zed's built-in Split Right so the TUI sits beside the code without changing dock settings."}, {"id": "readme_listener_port", "label": "Listener 127.0.0.1:10043", "file_type": "concept", "source_file": "README.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_smoke_case", "label": "In-Memory Smoke Case", "file_type": "concept", "source_file": "README.md", "source_location": "L145", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run on a file with no stored cases adds one empty input/expected case so compile and crash can still be checked. Only one run is active; Esc, edit, delete, or a new problem cancels it and kills the child process group."}, {"id": "readme_output_truncation", "label": "Output Truncation and Spill", "file_type": "concept", "source_file": "README.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outside edit mode, raw output is cut to a ~24 KB preview and panes show at most 300 lines / 24k characters; huge WA skips the character diff. The large pane dialog keeps full output up to 10 MB / 20,000 lines, then spills to a temp file and diffs the visible page."}, {"id": "readme_captcha", "label": "CAPTCHA Handling", "file_type": "concept", "source_file": "README.md", "source_location": "L169-L171", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When Codeforces serves an invisible CAPTCHA, the TUI alerts the user and Safari foregrounds itself; after the user solves it, live verdict polling resumes automatically."}, {"id": "readme_actor_model", "label": "Single-Channel Actor Model", "file_type": "rationale", "source_file": "README.md", "source_location": "L175-L195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI thread owns all state. Receiver, runner, and submitter workers only exchange PassingCommand envelopes on one channel and never hold a handle to another worker."}, {"id": "readme_main_rs", "label": "main.rs Event Loop", "file_type": "code", "source_file": "README.md", "source_location": "L179", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_helper_rs", "label": "helper.rs UI State Machine", "file_type": "code", "source_file": "README.md", "source_location": "L180", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_receiver", "label": "receiver.rs HTTP Listener", "file_type": "code", "source_file": "README.md", "source_location": "L188", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_runner", "label": "runner.rs Test Runner", "file_type": "code", "source_file": "README.md", "source_location": "L189", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_submitter", "label": "submitter.rs Safari Submitter", "file_type": "code", "source_file": "README.md", "source_location": "L190", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fs_ops", "label": "fs_ops.rs Storage", "file_type": "code", "source_file": "README.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_passing_command", "label": "PassingCommand", "file_type": "concept", "source_file": "README.md", "source_location": "L195", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_syspolicyd", "label": "syspolicyd Latency Fix", "file_type": "rationale", "source_file": "README.md", "source_location": "L203-L208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "macOS syspolicyd adds about 200ms when running newly compiled binaries. Adding Zed and the terminal under Developer Tools and Full Disk Access drops execution latency to about 3-4ms."}, {"id": "readme_pch", "label": "Precompiled Headers", "file_type": "concept", "source_file": "README.md", "source_location": "L210-L241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiling bits/stdc++.h dominates a cold run. A shared PCH cuts it from roughly 0.3s to 0.1s on an M-series Mac, but zch adds no flags itself; the user must pass -include-pch. Standard, architecture, and compiler version must match, and Homebrew GCC cannot use a Clang-built PCH."}, {"id": "readme_std_with_pbds", "label": "std-with-pbds", "file_type": "concept", "source_file": "README.md", "source_location": "L225-L245", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apple Clang does not ship bits/stdc++.h or policy-based data structures. The std-with-pbds helper repo sets both up for Apple Clang and supplies the header used to build the PCH."}, {"id": "readme_homebrew", "label": "Homebrew Install", "file_type": "concept", "source_file": "README.md", "source_location": "L46-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sample_png", "label": "sample.png 1ms Run Screenshot", "file_type": "image", "source_file": "README.md", "source_location": "L201", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_zch", "target": "readme_zed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_zch", "target": "readme_competitive_companion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L9", "weight": 1.0}, {"source": "readme_zch", "target": "readme_codeforces", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L9", "weight": 1.0}, {"source": "readme_zch", "target": "readme_safari_automation", "relation": "references", "confidence": "EXTRACTED